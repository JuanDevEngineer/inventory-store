# ---- Frontend (Vite) ----
# PostgREST API (docker compose service "postgrest")
VITE_API_URL=http://localhost:3000

# ---- docker compose ----
# All of these have defaults in docker-compose.yaml; set them to override.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory
# Password PostgREST uses to connect to Postgres
AUTHENTICATOR_PASSWORD=authenticator
# Signs the session tokens. Use a random string of at least 32 characters.
JWT_SECRET=change-me-to-a-random-secret-of-32-chars-or-more
